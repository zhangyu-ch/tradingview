import pathlib

"""
服务总配置文件
"""

# WEB服务访问IP地址，本机部署设置为 127.0.0.1；局域网或外网部署，设置为该机器的IP地址，或者设置 0.0.0.0 则可使用机器所有IP地址进行访问。
WEB_HOST = '127.0.0.1'

# WEB 登录设置：
# - 仅监听 127.0.0.1 / localhost 时，可以保持为空，页面仍会自动登录。
# - 监听 0.0.0.0、局域网或公网地址时，必须设置 LOGIN_PWD_HASH（推荐）或 LOGIN_PWD。
# - LOGIN_PWD 保留用于兼容旧配置；新部署建议只设置 LOGIN_PWD_HASH。
LOGIN_PWD = ''
LOGIN_PWD_HASH = ''

# Web 认证主体同时作为 TradingView 存储的不可伪造 owner。多用户部署应由认证系统为每个用户分配稳定且唯一的 ID。
WEB_AUTH_PRINCIPAL = 'tradingview_zy'
# 仅认领经过管理员审计的旧 TradingView user_id；当前旧前端固定发送 999。未知 owner 永不自动迁移。
TV_STORAGE_LEGACY_USER_IDS = ['999']

# Flask 会话签名密钥。留空时首次启动会自动生成并保存到 DATA_PATH/web_secret_key。
# 容器或多实例部署可通过环境变量 TRADINGVIEW_ZY_WEB_SECRET_KEY 设置固定值（至少 32 字节）。
WEB_SECRET_KEY = ''

# 业务凭据只允许使用 env://、managed://、file:// 或 keyring:// 引用。
# 临时迁移旧私有配置时才可显式改为 True；默认拒绝所有明文业务 Secret。
SECRET_ALLOW_LEGACY_PLAINTEXT = False

# 本地 HTTP 部署保持 False；经 HTTPS 反向代理访问时改为 True。
WEB_COOKIE_SECURE = False
WEB_REMEMBER_DAYS = 30
WEB_MAX_LOGIN_ATTEMPTS = 5
WEB_LOGIN_ATTEMPT_WINDOW_SECONDS = 300
WEB_CSRF_TRUSTED_ORIGINS = []  # 反向代理外部域名，例如 https://example.com
WEB_MAX_UPLOAD_BYTES = 1048576  # Web 上传请求上限：1 MiB
TV_STORAGE_CHART_MAX_BYTES = 524288  # 单个图表布局：512 KiB
TV_STORAGE_TEMPLATE_MAX_BYTES = 262144  # 单个指标模板：256 KiB
TV_STORAGE_DRAWING_MAX_BYTES = 524288  # 单个绘图状态：512 KiB
TV_STORAGE_MAX_CHARTS = 100
TV_STORAGE_MAX_TEMPLATES = 200
TV_STORAGE_MAX_DRAWINGS = 2000
TV_STORAGE_MAX_TOTAL_BYTES = 16777216  # 每 client/user 三类合计：16 MiB
WEB_MAX_WATCHLIST_IMPORT_LINES = 5000
WEB_MAX_WATCHLIST_LINE_BYTES = 512
WEB_TICKS_MAX_CODES = 200
WEB_TICKS_MAX_CODE_BYTES = 128
